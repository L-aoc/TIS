<Window x:Class="TisViewer.CreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="新建 TIS 文件"
        Width="1040"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,20,0,9" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#6F7785" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <!--  Title bar  -->
        <Border Grid.Row="0"
                Background="#0E1117"
                BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Width="22" Height="22" Source="Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="新建 TIS 文件"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="按列表顺序打包，第一项会作为默认封面"
                               FontSize="11.5"
                               Foreground="#6F7785"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButton}"
                            Content="&#xE921;"
                            ToolTip="最小化"
                            Click="Window_Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource WindowButton}"
                            Content="&#xE922;"
                            ToolTip="最大化"
                            Click="Window_Maximize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="关闭"
                            Click="Window_Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Content  -->
        <Grid Grid.Row="1" Margin="20,18,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="356" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Padding="12,8" Click="AddFiles_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0" />
                                        <TextBlock Text="添加文件" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TextButton}"
                                        Content="添加文件夹"
                                        Margin="8,0,0,0"
                                        Click="AddFolder_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="MoveUpButton"
                                        Style="{StaticResource ToolButton}"
                                        Content="&#xE74A;"
                                        ToolTip="上移"
                                        Click="MoveUp_Click" />
                                <Button x:Name="MoveDownButton"
                                        Style="{StaticResource ToolButton}"
                                        Content="&#xE74B;"
                                        ToolTip="下移"
                                        Click="MoveDown_Click" />
                                <Button x:Name="RemoveButton"
                                        Style="{StaticResource ToolButton}"
                                        Content="&#xE74D;"
                                        ToolTip="移除所选"
                                        Click="Remove_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ItemList"
                                 Style="{StaticResource MediaListBox}"
                                 Margin="8,8,4,8"
                                 SelectionMode="Extended"
                                 AllowDrop="True"
                                 SelectionChanged="ItemList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="ItemList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="ItemList_PreviewMouseMove"
                                 DragOver="ItemList_DragOver"
                                 Drop="ItemList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding IndexText}"
                                                   FontSize="11"
                                                   Foreground="#5F6878"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="1"
                                                Width="54"
                                                Height="54"
                                                CornerRadius="8"
                                                Background="#0E1117"
                                                ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="18"
                                                           Foreground="#495364"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                <Border Width="22"
                                                        Height="22"
                                                        CornerRadius="11"
                                                        Background="#B3000000"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="&#xE768;"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="8"
                                                               Foreground="#F5F2EA"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,0,0" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}"
                                                       FontSize="10.5"
                                                       Foreground="#737C8B"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="3"
                                                Visibility="{Binding IsCover, Converter={StaticResource BoolToVis}}"
                                                Background="#24F2B45C"
                                                BorderBrush="#55F2B45C"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="封面" FontSize="9.5" Foreground="#F4C98E" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="EmptyHint"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Border Width="54" Height="54" CornerRadius="14" Background="#151A22" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B9;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="23"
                                           Foreground="#4C5666"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="还没有添加文件"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#A7AEBA"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="点击「添加文件」，或把照片、视频拖进来"
                                       FontSize="11.5"
                                       Foreground="#6F7785"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource Stroke}"
                            BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <Grid>
                            <TextBlock x:Name="SummaryText"
                                       Text="共 0 项"
                                       FontSize="11.5"
                                       Foreground="#7B8492"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="拖动列表项可调整顺序"
                                       FontSize="10.5"
                                       Foreground="#5F6878"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  Settings  -->
            <Border Grid.Column="2"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1"
                    CornerRadius="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,14,18">
                    <StackPanel>
                        <TextBlock Text="封面" Style="{StaticResource SectionHeader}" Margin="0,10,0,9" />
                        <Border Height="164" CornerRadius="10" Background="#0D1016" BorderBrush="{StaticResource Stroke}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="CoverPlaceholder"
                                           Text="&#xE91B;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="30"
                                           Foreground="#333C4A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image x:Name="CoverPreview" Stretch="Uniform" />
                                <Border VerticalAlignment="Bottom" Background="#CC0B0D11" Padding="10,7">
                                    <TextBlock x:Name="CoverCaption"
                                               Text="未选择封面"
                                               FontSize="11"
                                               Foreground="#C9CFD9"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="SetCoverButton"
                                    Content="设为封面"
                                    Style="{StaticResource GhostButton}"
                                    Padding="12,7"
                                    Click="SetCover_Click" />
                            <Button x:Name="ClearCoverButton"
                                    Content="取消封面"
                                    Style="{StaticResource GhostButton}"
                                    Padding="12,7"
                                    Margin="8,0,0,0"
                                    Click="ClearCover_Click" />
                        </StackPanel>

                        <TextBlock Text="保存为" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="文件名" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="FileNameBox"
                                 Style="{StaticResource InputBox}"
                                 Text="我的相册.tis"
                                 TextChanged="FileNameBox_TextChanged" />

                        <TextBlock Text="保存位置" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" Style="{StaticResource InputBox}" />
                            <Button Grid.Column="1"
                                    Content="浏览"
                                    Style="{StaticResource GhostButton}"
                                    Padding="12,8"
                                    Margin="8,0,0,0"
                                    Click="BrowseFolder_Click" />
                        </Grid>

                        <TextBlock Text="压缩方式" Style="{StaticResource SectionHeader}" />
                        <WrapPanel>
                            <RadioButton x:Name="CompressionBalanced"
                                         Content="标准"
                                         Style="{StaticResource ChipRadio}"
                                         GroupName="Compression"
                                         Tag="Balanced"
                                         IsChecked="True"
                                         ToolTip="压缩与速度兼顾，推荐" />
                            <RadioButton Content="高压缩"
                                         Style="{StaticResource ChipRadio}"
                                         GroupName="Compression"
                                         Tag="Maximum"
                                         ToolTip="文件更小，生成更慢" />
                            <RadioButton Content="快速"
                                         Style="{StaticResource ChipRadio}"
                                         GroupName="Compression"
                                         Tag="Fast"
                                         ToolTip="压缩更快，文件略大" />
                            <RadioButton Content="最快"
                                         Style="{StaticResource ChipRadio}"
                                         GroupName="Compression"
                                         Tag="Fastest"
                                         ToolTip="压缩最快，文件略大" />
                        </WrapPanel>

                        <Border Background="#0F1319"
                                BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11,9"
                                Margin="0,16,0,0">
                            <TextBlock Text="封面只影响打开时首先显示的画面。列表顺序就是浏览顺序，可用 ← → 逐项查看。"
                                       FontSize="10.5"
                                       Foreground="#737C8B"
                                       TextWrapping="Wrap"
                                       LineHeight="17" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  Footer  -->
        <Border Grid.Row="2"
                Background="#0E1117"
                BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="12"
                               Foreground="#5F6878"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />
                    <TextBlock Text="支持 JPG / PNG / GIF / WEBP / MP4 / MOV 等系统可解码的格式"
                               FontSize="10.5"
                               Foreground="#6F7785"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消"
                            Style="{StaticResource GhostButton}"
                            Padding="18,9"
                            Click="Cancel_Click" />
                    <Button x:Name="GenerateButton"
                            Content="生成 TIS"
                            Style="{StaticResource PrimaryButton}"
                            Padding="24,10"
                            Margin="10,0,0,0"
                            Click="Generate_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Progress overlay  -->
        <Border x:Name="ProgressOverlay" Grid.RowSpan="3" Background="#E60B0D11" Visibility="Collapsed">
            <Border Width="460"
                    Padding="28"
                    CornerRadius="16"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="正在生成 TIS 相册"
                               FontSize="17"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ProgressText"
                               Text="准备中…"
                               FontSize="11.5"
                               Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,18" />
                    <ProgressBar x:Name="ProgressBarControl"
                                 Style="{StaticResource FlatProgress}"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100" />
                    <TextBlock x:Name="ProgressDetail"
                               Text=""
                               FontSize="10.5"
                               Foreground="#6F7785"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <Button Content="取消生成"
                            Style="{StaticResource TextButton}"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,0"
                            Click="CancelGeneration_Click" />
                </StackPanel>
            </Border>
        </Border>

        <!--  Success overlay  -->
        <Border x:Name="SuccessOverlay" Grid.RowSpan="3" Background="#E60B0D11" Visibility="Collapsed">
            <Border Width="480"
                    Padding="30"
                    CornerRadius="18"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="18" Background="#1B2A22" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="24"
                                   Foreground="#8CCB9B"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="已生成 TIS 相册"
                               FontSize="19"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock x:Name="SuccessPath"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Content="打开查看"
                                Style="{StaticResource PrimaryButton}"
                                Click="OpenGenerated_Click" />
                        <Button Content="在文件夹中显示"
                                Style="{StaticResource GhostButton}"
                                Margin="10,0,0,0"
                                Click="ShowGenerated_Click" />
                        <Button Content="完成"
                                Style="{StaticResource TextButton}"
                                Margin="6,0,0,0"
                                Click="Done_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
