<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TisViewer</AssemblyName>
    <RootNamespace>TisViewer</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>TIS 相册</Product>
    <Description>TIS 相册查看器与生成器（.tis = 7z 压缩包）</Description>
    <Company>TIS</Company>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <PublishSingleFile>false</PublishSingleFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);scratch/**;.nuget/**;dist/**;demo/**</DefaultItemExcludes>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
