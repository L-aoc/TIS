<Window x:Class="TisViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TIS 相册"
        Width="1000"
        Height="700"
        MinWidth="840"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BigPlayStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="74" />
            <Setter Property="Height" Value="74" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="#D9E8B264" />
                            <TextBlock Text="&#xE768;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="25"
                                       Foreground="#141414"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Compact title bar  -->
        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="#0E0E10"
                BorderBrush="#242427"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel x:Name="ViewerHeader"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="HomeButton"
                            Style="{StaticResource ToolButton}"
                            Content="&#xE72B;"
                            ToolTip="返回首页"
                            Click="Home_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <TextBlock x:Name="TitleText"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               MaxWidth="190"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="InfoMeta"
                               FontSize="10.5"
                               Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               MaxWidth="90"
                               TextTrimming="CharacterEllipsis" />
                    <Border x:Name="PageBadge"
                            Margin="10,0,0,0"
                            Padding="7,2"
                            CornerRadius="5"
                            Background="#1D1D20"
                            BorderBrush="#303034"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="InfoIndex"
                                   Text="1 / 1"
                                   FontSize="10"
                                   Foreground="#B9B9BF" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="ViewerActions"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Button x:Name="OpenQuickButton"
                                Style="{StaticResource ToolButton}"
                                Content="&#xE8E5;"
                                ToolTip="打开 TIS 文件 (Ctrl+O)"
                                Click="OpenFile_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="NewQuickButton"
                                Style="{StaticResource ToolButton}"
                                Content="&#xE710;"
                                ToolTip="新建 TIS 文件 (Ctrl+N)"
                                Click="NewArchive_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Border Width="1" Height="16" Background="#303034" Margin="6,0,6,0" />
                    </StackPanel>

                    <Button Style="{StaticResource WindowButton}"
                            Content="&#xE921;"
                            ToolTip="最小化"
                            Click="Window_Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowButton}"
                            Content="&#xE922;"
                            ToolTip="最大化"
                            Click="Window_Maximize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="关闭"
                            Click="Window_Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!--  Home: compact sidebar + recent grid  -->
            <Grid x:Name="HomeView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#141416"
                        BorderBrush="#26262A"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="16,18,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Image Width="28"
                                   Height="28"
                                   Source="Assets/app.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TIS 相册" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Text="本地相册容器" FontSize="10" Foreground="#73737A" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,26,0,0">
                            <Button Style="{StaticResource SidebarButton}" Click="OpenFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="15"
                                               Foreground="#C9C9CF"
                                               Width="26"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="打开 TIS 文件" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButton}" Click="NewArchive_Click" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="15"
                                               Foreground="#C9C9CF"
                                               Width="26"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="封装 TIS 文件" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButton}" Click="ToggleAssociation_Click" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71B;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="15"
                                               Foreground="#C9C9CF"
                                               Width="26"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="关联 .tis 文件" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="AssociationStatus"
                                       Text="未关联 · 双击 .tis 不会自动打开"
                                       FontSize="10"
                                       Foreground="#6E6E75"
                                       Margin="4,9,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Row="3"
                                Background="#152F39"
                                BorderBrush="#24505E"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Foreground="#7FC3D8"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="安全提示"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#9AC9D8"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="请确保 TIS 文件来源可信，以防止设备受到安全侵害。"
                                           FontSize="10"
                                           Foreground="#8CB9C7"
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="#0F0F10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="24,16,24,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="最近打开" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="RecentCount"
                                       Text="0 个文件"
                                       FontSize="10.5"
                                       Foreground="#73737A"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="清空"
                                Style="{StaticResource TextButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ClearRecent_Click" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10,16,16">
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RecentTile}"
                                                Tag="{Binding Path}"
                                                ToolTip="{Binding Path}"
                                                Click="Recent_Click">
                                            <StackPanel Width="150">
                                                <Border Width="150"
                                                        Height="142"
                                                        CornerRadius="10"
                                                        Background="#1A1A1D"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="25"
                                                                   Foreground="#47474E"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        <Border Width="24"
                                                                Height="24"
                                                                CornerRadius="12"
                                                                Background="#B3000000"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="&#xE768;"
                                                                       FontFamily="{StaticResource IconFont}"
                                                                       FontSize="9"
                                                                       Foreground="#F1EFE9"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Margin="2,0,0,0" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="2,9,0,0" />
                                                <TextBlock Text="{Binding When}"
                                                           FontSize="10"
                                                           Foreground="#73737A"
                                                           Margin="2,4,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="RecentEmpty"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="54" Height="54" CornerRadius="15" Background="#1A1A1D" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B9;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="23"
                                           Foreground="#4A4A51"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="还没有打开过 TIS 文件"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#A9A9B0"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="打开一个 .tis，它会以封面缩略图出现在这里"
                                       FontSize="10.5"
                                       Foreground="#6E6E75"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0" />
                            <Button Content="打开 TIS 文件"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0"
                                    Click="OpenFile_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!--  Viewer: compact QuickLook-like media window  -->
            <Grid x:Name="ViewerView" Background="#0A0A0B" Visibility="Collapsed" ClipToBounds="True">
                <Grid x:Name="MediaStage"
                      Background="#0A0A0B"
                      ClipToBounds="True"
                      MouseWheel="MediaStage_MouseWheel"
                      MouseLeftButtonDown="MediaStage_MouseLeftButtonDown"
                      MouseLeftButtonUp="MediaStage_MouseLeftButtonUp"
                      MouseMove="MediaStage_MouseMove">
                    <Image x:Name="ImageHost"
                           Stretch="Uniform"
                           RenderTransformOrigin="0.5,0.5"
                           Visibility="Collapsed"
                           SnapsToDevicePixels="True" />
                    <MediaElement x:Name="VideoHost"
                                  Stretch="Uniform"
                                  Visibility="Collapsed"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  ScrubbingEnabled="True"
                                  Focusable="False"
                                  MediaOpened="VideoHost_MediaOpened"
                                  MediaEnded="VideoHost_MediaEnded"
                                  MediaFailed="VideoHost_MediaFailed" />
                </Grid>

                <Button x:Name="BigPlayButton"
                        Style="{StaticResource BigPlayStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="PlayPause_Click" />

                <Button x:Name="PrevButton"
                        Style="{StaticResource NavButton}"
                        Content="&#xE76B;"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0"
                        ToolTip="上一张 (←)"
                        Click="Prev_Click" />
                <Button x:Name="NextButton"
                        Style="{StaticResource NavButton}"
                        Content="&#xE76C;"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        ToolTip="下一张 (→)"
                        Click="Next_Click" />

                <Border x:Name="LoadingOverlay" Background="#CC0A0A0B" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="36" Height="36" HorizontalAlignment="Center">
                            <Ellipse Stroke="#22FFFFFF" StrokeThickness="3" />
                            <Ellipse Stroke="{StaticResource Accent}"
                                     StrokeThickness="3"
                                     StrokeDashArray="7 9"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerTransform" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="LoadingText"
                                   Text="正在加载…"
                                   FontSize="11.5"
                                   Foreground="#C9C9CF"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                        <ProgressBar x:Name="LoadingProgress"
                                     Style="{StaticResource FlatProgress}"
                                     Width="180"
                                     Margin="0,12,0,0"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorOverlay" Background="#E60A0A0B" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <Border Width="46" Height="46" CornerRadius="13" Background="#2A1B18" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="19"
                                       Foreground="#E08A78"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="ErrorTitle"
                                   Text="无法显示这个文件"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock x:Name="ErrorDetail"
                                   Text=""
                                   FontSize="11.5"
                                   Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="用默认应用打开"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8"
                                    Click="ErrorOpenDefault_Click" />
                            <Button Content="在文件夹中显示"
                                    Style="{StaticResource GhostButton}"
                                    Padding="16,8"
                                    Margin="8,0,0,0"
                                    Click="ErrorReveal_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="VideoControls"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="14,0,14,16"
                        MaxWidth="560"
                        MinWidth="420"
                        Padding="8,6,10,6"
                        Background="#D9141417"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource ToolButton}"
                                Width="30"
                                Height="30"
                                Content="&#xE768;"
                                ToolTip="播放 / 暂停 (空格)"
                                Click="PlayPause_Click" />
                        <TextBlock x:Name="CurrentTimeText"
                                   Grid.Column="1"
                                   Text="00:00"
                                   FontSize="10.5"
                                   Foreground="#C7C7CD"
                                   VerticalAlignment="Center"
                                   Margin="4,0,8,0"
                                   MinWidth="36" />
                        <Slider x:Name="PositionSlider"
                                Grid.Column="2"
                                Style="{StaticResource MediaSlider}"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="1"
                                MinWidth="100"
                                ValueChanged="PositionSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp" />
                        <TextBlock x:Name="TotalTimeText"
                                   Grid.Column="3"
                                   Text="00:00"
                                   FontSize="10.5"
                                   Foreground="#7F7F86"
                                   VerticalAlignment="Center"
                                   Margin="8,0,6,0"
                                   MinWidth="36" />
                        <Button x:Name="MuteButton"
                                Grid.Column="4"
                                Style="{StaticResource ToolButton}"
                                Width="30"
                                Height="30"
                                Content="&#xE767;"
                                ToolTip="静音 (M)"
                                Click="Mute_Click" />
                    </Grid>
                </Border>

                <Border x:Name="Toast"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,80"
                        Padding="12,7"
                        CornerRadius="7"
                        Background="#E61D1D20"
                        BorderBrush="#2AFFFFFF"
                        BorderThickness="1">
                    <TextBlock x:Name="ToastText" Text="" FontSize="11" Foreground="#E9E9E5" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
